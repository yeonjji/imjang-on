generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, pg_trgm, fuzzystrmatch, postgis_tiger_geocoder, postgis_topology]
}

model Region {
  code         String   @id @db.VarChar(10)
  sido         String   @db.VarChar(20)
  sigungu      String?  @db.VarChar(40)
  eupmyeondong String?  @db.VarChar(40)
  ri           String?  @db.VarChar(40)
  fullName     String   @db.VarChar(120)
  level        Int
  parentCode   String?  @db.VarChar(10)
  parent       Region?  @relation("RegionTree", fields: [parentCode], references: [code])
  children     Region[] @relation("RegionTree")

  isAbolished   Boolean   @default(false)
  abolishedAt   DateTime? @db.Date
  sourceVersion String    @db.VarChar(20)
  updatedAt     DateTime  @updatedAt

  sigunguCode String? @db.VarChar(5)

  properties Property[]

  @@index([sido, sigungu, eupmyeondong])
  @@index([level, isAbolished])
}

enum PropertyType {
  APARTMENT
  OFFICETEL
  ROW_HOUSE
  MULTIPLEX
}

model Property {
  id            BigInt       @id @default(autoincrement())
  propertyType  PropertyType
  name          String       @db.VarChar(80)
  nameNorm      String       @db.VarChar(80)
  regionCode    String       @db.VarChar(10)
  region        Region       @relation(fields: [regionCode], references: [code])
  address       String       @db.VarChar(200)
  builtYear     Int?
  households    Int?
  buildingCount Int?
  areaTypes     Int[]        @default([])

  txCountTotal Int       @default(0)
  txCount12m   Int       @default(0)
  lastTxAt     DateTime?

  saleCount12m    Int       @default(0)
  saleAvgPrice12m BigInt?
  saleLastPrice   BigInt?
  saleLastAt      DateTime? @db.Date

  jeonseCount12m      Int       @default(0)
  jeonseAvgDeposit12m BigInt?
  jeonseLastDeposit   BigInt?
  jeonseLastAt        DateTime? @db.Date

  wolseCount12m      Int       @default(0)
  wolseAvgDeposit12m BigInt?
  wolseAvgRent12m    Int?
  wolseLastDeposit   BigInt?
  wolseLastRent      Int?
  wolseLastAt        DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sigunguCode String?                               @db.VarChar(5)
  location    Unsupported("geography(Point,4326)")?

  transactions Transaction[]

  // 2026-07-01 행정구역 개편: 폐지지역 구 property → 신 property 301 리다이렉트(삭제 없음).
  redirectToId   BigInt?
  redirectTo     Property?    @relation("PropertyRedirect", fields: [redirectToId], references: [id], onDelete: SetNull)
  redirectedFrom Property[]   @relation("PropertyRedirect")

  // Property_dedupe_key — (propertyType, nameNorm, regionCode, address) WHERE redirectToId IS NULL
  // 부분 유니크 인덱스라 Prisma 스키마로 표현할 수 없다. raw SQL 마이그레이션
  // 20260729000000_add_property_dedupe_unique 참조. 같은 이유로 관리되는 인덱스가
  // 이미 여럿 있다(Property_nameNorm_trgm_idx, Property_location_gix, Property_areaTypes_gin).
  @@index([propertyType, regionCode])
  @@index([redirectToId])
  @@index([name])
  @@index([propertyType, lastTxAt(sort: Desc)])
  @@index([propertyType, saleLastAt(sort: Desc)])
  @@index([propertyType, saleCount12m(sort: Desc)])
  @@index([propertyType, jeonseLastAt(sort: Desc)])
  @@index([propertyType, jeonseCount12m(sort: Desc)])
  @@index([propertyType, wolseLastAt(sort: Desc)])
  @@index([propertyType, wolseCount12m(sort: Desc)])
  @@index([propertyType, saleAvgPrice12m])
  @@index([propertyType, jeonseAvgDeposit12m])
  @@index([propertyType, wolseAvgDeposit12m])
}

enum DealType {
  SALE
  JEONSE
  WOLSE
}

// 2026-07-01 개편 폐지지역 orphan 삭제(방식 B1) 후에도 구 URL을 신 URL로 301하기 위한 매핑.
// 구 Property/School 행 삭제 전 여기에 스냅샷한다(삭제하면 redirectToId가 사라지므로).
model UrlRedirect {
  kind   String @db.VarChar(12) // 'property' | 'school'
  fromId BigInt
  toPath String @db.VarChar(120)

  @@id([kind, fromId])
}

model Transaction {
  id           BigInt       @id @default(autoincrement())
  propertyId   BigInt
  property     Property     @relation(fields: [propertyId], references: [id])
  propertyType PropertyType
  regionCode   String       @db.VarChar(10)
  sigunguCode  String       @db.VarChar(5)

  dealType      DealType
  contractDate  DateTime @db.Date
  exclusiveArea Decimal  @db.Decimal(6, 2)
  floor         Int?
  buildYear     Int?

  dealAmount   Int?
  registerDate DateTime? @db.Date
  dealingType  String?   @db.VarChar(20)
  buyerType    String?   @db.VarChar(20)
  sellerType   String?   @db.VarChar(20)
  cancelDate   DateTime? @db.Date
  cancelType   String?   @db.VarChar(20)

  deposit        Int?
  monthlyRent    Int?
  contractTerm   String?  @db.VarChar(20)
  contractType   String?  @db.VarChar(20)
  useRRRight     Boolean?
  preDeposit     Int?
  preMonthlyRent Int?

  umd         String? @db.VarChar(40)
  jibun       String? @db.VarChar(40)
  roadName    String? @db.VarChar(120)
  source      String  @db.VarChar(30)
  externalKey String? @db.VarChar(80)
  rawHash     String  @db.Char(64)
  createdAt    DateTime @default(now())

  @@unique([rawHash])
  @@index([propertyId, dealType, contractDate(sort: Desc)])
  @@index([propertyId, contractDate(sort: Desc)])
  @@index([sigunguCode, propertyType, dealType, contractDate(sort: Desc)])
  @@index([regionCode, contractDate(sort: Desc)])
  @@index([propertyType, contractDate(sort: Desc)])
  @@index([dealType, createdAt(sort: Desc)])
  @@index([dealType, contractDate(sort: Desc)])
  @@index([contractDate, sigunguCode])
}

/// 홈 대시보드(시장 브리핑·인기지역)용 사전계산 스냅샷.
/// 5M행 transaction 집계는 요청 경로에서 너무 느려, 일일 ingest에서 미리 계산해 저장하고
/// 홈은 이 행을 즉시 읽는다. key별 1행(예: 'market_briefing', 'popular_sigungus').
model DashboardSnapshot {
  key        String   @id @db.VarChar(40)
  payload    Json
  computedAt DateTime @updatedAt
}

enum IngestionStatus {
  RUNNING
  OK
  ERROR
}

model IngestionRun {
  id           BigInt          @id @default(autoincrement())
  source       String          @db.VarChar(40)
  targetKey    String          @db.VarChar(40)
  status       IngestionStatus
  rowsUpserted Int             @default(0)
  errorMessage String?         @db.Text
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?

  @@index([source, targetKey])
  @@index([status, startedAt(sort: Desc)])
}

model LoanProduct {
  seq        Int      @id // API 자연키
  finprdnm   String // 상품명 (길이 제한 없음 — 한 값 초과가 전체 스냅샷을 막는 위험 회피)
  ofrinstnm  String? // 제공기관
  instCtg    String? // 기관구분
  lnlmt      Int? // 한도(만원)
  irt        String? // 금리(텍스트, 설명형이라 길이 제한 없음)
  irtCtg     String? // 금리구분(설명형이라 길이 제한 없음)
  usageTags  String[] @default([]) // 자금용도 태그
  targetTags String[] @default([]) // 대상 태그
  regionTags String[] @default([]) // 시도 태그
  rawJson    Json // 전체 원본
  updatedAt  DateTime @default(now())

  @@index([finprdnm])
}

model JeonseGuaranteeProduct {
  grntDvcd               String   @id // 보증구분코드 (API 자연키)
  rcmdProdNm             String // 추천상품명
  rcmdGrntProdDvcd       String? // 01 일반 / 02 협약 / 03 특례
  grntReqTrgtDvcd        String? // 00 전체 / 01 청년 / 02 신혼부부 / 03 기타
  reqTrgtCont            String? // 신청대상 요약('|' 구분, 길이제한 없음)
  exptGrfeRateCont       String? // 예상 보증료율(텍스트)
  intSprtCont            String? // 이자지원 내용
  grntPrmeCont           String? // 우대내용
  rentGrntMaxLoanLmtRate Float? // 임차보증금액 대비 최대대출한도비율(%)
  maxLoanLmtAmt          Int? // 상품 최대대출한도(원, <2.1B)
  trtBankCont            String? // 취급은행 금융기관코드('|' 구분)
  guidUrl                String? // 안내링크
  rawJson                Json
  updatedAt              DateTime @default(now())

  @@index([grntReqTrgtDvcd])
}

model JeonseRegionLimit {
  id             BigInt   @id @default(autoincrement())
  grntDvcd       String // 보증구분코드(상품)
  trgtLwdgCd     String // 목적물주소 법정동코드(시도 단위)
  maxRentGrntAmt Int // 최대임차보증금액(원)
  updatedAt      DateTime @default(now())

  @@unique([grntDvcd, trgtLwdgCd])
  @@index([trgtLwdgCd])
}

model EmailSignup {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique @db.VarChar(120)
  topic     String   @db.VarChar(40)
  createdAt DateTime @default(now())

  @@index([topic])
}

model EvCharger {
  id           BigInt                                @id @default(autoincrement())
  sourceId     String                                @unique @db.VarChar(80)
  name         String                                @db.VarChar(100)
  address      String                                @db.VarChar(200)
  location     Unsupported("geography(Point,4326)")?
  chargeSpeed  String                                @db.VarChar(10)
  chargerCount Int
  operatorName String?                               @db.VarChar(80)
  updatedAt    DateTime                              @updatedAt

  units EvChargerUnit[]

  @@index([chargeSpeed])
}

model EvChargerUnit {
  id              BigInt   @id @default(autoincrement())
  sourceId        String   @unique @db.VarChar(120) // statId-chgerId
  stationSourceId String   @db.VarChar(80)
  station         EvCharger @relation(fields: [stationSourceId], references: [sourceId], onDelete: Cascade)
  chgerId         String   @db.VarChar(20)
  chgerType       String   @db.VarChar(4)
  isFast          Boolean
  updatedAt       DateTime @updatedAt

  @@index([stationSourceId])
}

model TraditionalMarket {
  id          BigInt                                @id @default(autoincrement())
  sourceId    String                                @unique @db.VarChar(80)
  name        String                                @db.VarChar(100)
  address     String                                @db.VarChar(200)
  location    Unsupported("geography(Point,4326)")?
  marketType  String?                               @db.VarChar(40)
  sigunguCode String?                               @db.VarChar(5)
  updatedAt   DateTime                              @updatedAt

  @@index([sigunguCode])
  @@index([marketType])
}

model Store {
  id           BigInt                                @id @default(autoincrement())
  sourceId     String                                @unique @db.VarChar(80)
  name         String                                @db.VarChar(100)
  address      String                                @db.VarChar(200)
  location     Unsupported("geography(Point,4326)")?
  industryCode String?                               @db.VarChar(20)
  industryName String?                               @db.VarChar(60)
  sigunguCode  String                                @db.VarChar(5)
  updatedAt    DateTime                              @updatedAt

  @@index([sigunguCode])
  @@index([industryCode])
}

model Park {
  id        BigInt                                @id @default(autoincrement())
  sourceId  String                                @unique @db.VarChar(80)
  name      String                                @db.VarChar(100)
  address   String                                @db.VarChar(200)
  location  Unsupported("geography(Point,4326)")?
  parkType  String?                               @db.VarChar(40)
  area      Float?
  referenceDate DateTime?                          @db.Date
  updatedAt DateTime                              @updatedAt

  @@index([parkType])
}

model School {
  id         BigInt                                @id @default(autoincrement())
  sourceId   String                                @unique @db.VarChar(80)
  name       String                                @db.VarChar(100)
  address    String                                @db.VarChar(200)
  location   Unsupported("geography(Point,4326)")?
  schoolKind String?                               @db.VarChar(20)
  foundType  String?                               @db.VarChar(20)
  coeduType  String?                               @db.VarChar(20)
  region     String?                               @db.VarChar(20)
  eduOffice  String?                               @db.VarChar(40)
  tel        String?                               @db.VarChar(30)
  homepage   String?                               @db.VarChar(200)
  sigunguCode String?                              @db.VarChar(5)
  updatedAt  DateTime                              @updatedAt

  @@index([schoolKind])
  @@index([region])
  @@index([sigunguCode, schoolKind])
}

