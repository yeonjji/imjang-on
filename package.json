{
  "name": "imjang-on",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/lib tests/ingest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:integration",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "seed:regions": "dotenv -e .env.local -- tsx scripts/ingest/regions/seed.ts",
    "seed:regions:api": "dotenv -e .env.local -- tsx scripts/ingest/regions/seed-from-api.ts",
    "ingest:run": "dotenv -e .env.local -- tsx scripts/ingest/transactions/runner.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "@prisma/client": "^5",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@sentry/nextjs": "^8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2",
    "fast-xml-parser": "^4",
    "lucide-react": "^0.460",
    "next": "^15",
    "pino": "^9",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^2",
    "tailwind-merge": "^2",
    "vaul": "^1",
    "zod": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "pino-pretty": "^11",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "prisma": "^5",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
