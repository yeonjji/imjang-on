# 테스트 전용 환경 — 로컬 docker DB(docker-compose.yml)만 가리킨다.
# 절대 운영(Supabase) URL을 여기 넣지 말 것. 테스트는 region/property/transaction을 전체 삭제한다.
# `docker compose up -d`로 로컬 DB를 먼저 띄운 뒤 사용한다.
DATABASE_URL="postgresql://imjang:dev@localhost:5433/imjang_on?schema=public"
DIRECT_URL="postgresql://imjang:dev@localhost:5433/imjang_on?schema=public"
LOG_LEVEL="warn"
